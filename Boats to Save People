import java.util.Arrays;
class Solution {
    public int numRescueBoats(int[] people, int limit) {
        int n=people.length-1;
        Arrays.sort(people);
        int m=0;
        int count=0;
        while(m<=n){
            if(people[m]+people[n]<=limit){
                m++;
            }
            n--;
            count++;
        }
        return count;
          
    }
}
