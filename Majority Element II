class Solution {
    public List<Integer> majorityElement(int[] nums) {
        ArrayList<Integer>res=new ArrayList<>();
        int n=nums.length;
       // int idx=0;
        for(int i=0;i<n;i++){
            if(res.contains(nums[i])){
                continue;
            }
            int count=0;
            for(int j=0;j<n;j++){
                if(nums[i]==nums[j]){
                    count++;
                   
                }
            }
            if(count>n/3){
                res.add(nums[i]);
            }
        }
       return res;
    }
}
