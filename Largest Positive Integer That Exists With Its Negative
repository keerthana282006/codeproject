class Solution {
    public int findMaxK(int[] nums) {
        int n=nums.length;
        int max=-1;
        HashSet<Integer>s=new HashSet<>();
        for(int i=0;i<n;i++){
            s.add(nums[i]);
        }
        for(int i=0;i<n;i++){
            if(nums[i]>max && s.contains(-nums[i])){
                max=nums[i];
            }
        }
        return max;

    }
}
