class Solution {
    public int duplicateNumbersXOR(int[] nums) {
        int n=nums.length;
        int ans=0;
        int count[]=new int[51];
        for(int i=0;i<n;i++){
            int curr=nums[i];
            count[curr]++;
            if(count[curr]==2){
                ans^=curr;
            }
        }
        return ans;
        
    }
}
