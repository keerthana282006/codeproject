import java.util.*;
class Solution {
    public String firstPalindrome(String[] words) {
        int n=words.length;
        String ans="";
        for(int i=0;i<n;i++){
            String res=new StringBuilder(words[i]).reverse().toString();
            if(res.equals(words[i])){
                ans+=words[i];
                break;
            }
        }
        return ans;
    }
}
