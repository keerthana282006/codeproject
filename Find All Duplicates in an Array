class Solution {
    public List<Integer> findDuplicates(int[] nums) {
        ArrayList<Integer>res=new ArrayList<>();
        HashSet<Integer>h=new HashSet<>();
        for(int i=0;i<nums.length;i++){
            if(!h.add(nums[i])){
                res.add(nums[i]);
            }
        }
       return res;
    }
}
