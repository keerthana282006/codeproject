class Solution {
    private static final int MOD = 1337;
    public int superPow(int a, int[] b) {
        a %= MOD; 
        int ans = 1;      
        for (int digit : b) {
            ans = (normalPow(ans, 10) * normalPow(a, digit)) % MOD;
        }      
        return ans;
    }
    private int normalPow(int base, int exp) {
        int res = 1;
        base %= MOD;   
        while (exp > 0) {
            if (exp % 2 == 1) {
                res = (res * base) % MOD;
            }
            base = (base * base) % MOD;
            exp /= 2;
        } 
        return res;
    }
}
