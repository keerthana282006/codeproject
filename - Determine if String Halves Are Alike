class Solution {
    public boolean halvesAreAlike(String s) {
        int n=s.length();
        int num=n/2;
        
        String first=s.substring(0,num);
        String sec=s.substring(num,n);
        return countvow(first)==countvow(sec);
    }
    private int countvow(String str){
        int count=0;
        String vowels="aeiouAEIOU";
        for(int i=0;i<str.length();i++){
            if(vowels.indexOf(str.charAt(i))!=-1){
                count++;
            }
        }
        return count;
    }
}
