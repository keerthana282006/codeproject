import java.util.*;
class Solution {
    public int mostWordsFound(String[] sentences) {
        int max=0;
        for(int i=0;i<sentences.length;i++){
            String res[]=sentences[i].split(" ");
            int count=res.length;
            if(count>max){
                max=count;
            }
        }
        return max;
    }
}
