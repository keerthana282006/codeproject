class Solution {
    public int maxProduct(String[] words) {
        int n = words.length;
        int[] masks = new int[n];
        for (int i = 0; i < n; i++) {
            int mask = 0;
            for (int c = 0; c < words[i].length(); c++) {
                mask |= (1 << (words[i].charAt(c) - 'a'));
            }
            masks[i] = mask;
        }      
        int ans = 0;
        for (int i = 0; i < n; i++) {
            for (int j = i + 1; j < n; j++) {
                if ((masks[i] & masks[j]) == 0) {
                    int m = words[i].length();
                    int k = words[j].length();
                    ans = Math.max(ans, m * k);
                }
            }
        }
        return ans;
    }
}
