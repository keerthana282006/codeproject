class Solution {
    public boolean isPrefixString(String s, String[] words) {
        int n = s.length();
        int flag = 0;
        String current = ""; 
        for (int i = 0; i < words.length; i++) { 
            current += words[i];      
            if (s.startsWith(current)) { 
                if (current.length() == n) { 
                    flag = 1;
                    break;
                }
            } else {
                break; 
            }
        }
        if (flag == 1) { 
            return true;
        }
        return false;
    }
}
