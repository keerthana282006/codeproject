class Solution {
    public int rob(int[] nums) {
        int n=nums.length;
        if(n<=0) return 0;
        if(n==1) return nums[0];
        int first=0;
        int sec=0;
        for(int i=0;i<n;i++){
            int curr=Math.max(first,sec+nums[i]);
            sec=first;
            first=curr;
        }
        return first;
    }
}
